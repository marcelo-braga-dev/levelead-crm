# Esqueleto de variáveis de ambiente para quando o scaffolding Laravel for criado.
# Ainda não há aplicação Laravel neste repositório — este arquivo serve de referência-alvo
# para a Fase 1 do plano (ver docs/PLANO_IMPLEMENTACAO.md). Ambiente local roda via Laravel Sail
# (ver docs/SETUP.md) — ajustar conforme `sail:install` gerar o `.env` real e mesclar com as
# variáveis abaixo.

APP_NAME="LeveLead CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
APP_PORT=8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Banco de dados (MySQL via container `mysql` do Laravel Sail — DB_HOST é o nome do
# serviço no docker-compose.yml, não 127.0.0.1)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=levelead_crm
DB_USERNAME=sail
DB_PASSWORD=password

# phpMyAdmin (serviço `phpmyadmin` do Sail) — acessível em http://localhost:8080
FORWARD_PHPMYADMIN_PORT=8080

# Fila (jobs: EvaluateLeadSlaJob, DistributeUnassignedLeadsJob, ProcessCsvImportJob, RecalculateLeadScoresJob)
QUEUE_CONNECTION=database

# Cache / sessão
CACHE_DRIVER=database
SESSION_DRIVER=database

# Storage de anexos de proposta (Laravel Filesystem — disco local no VPS na v1;
# abstraído para trocar para S3/MinIO na Fase 2 só via config, sem mudança de código)
FILESYSTEM_DISK=local

# E-mail (notificação de SLA breach ao gestor)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@levelead.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Criptografia de CPF de sócio (company_partners.cpf usa cast `encrypted` do Laravel,
# que depende de APP_KEY — não há variável adicional, mas reforçar que APP_KEY
# nunca pode ser regenerada após dados criptografados existirem em produção)

# Google Places API (New) — enriquecimento do perfil da Company (nota, avaliações, horário).
# Opcional: sem essa chave, a sincronização simplesmente fica indisponível (ver
# GooglePlacesClient::isConfigured()), nunca bloqueia o uso do CRM.
GOOGLE_PLACES_API_KEY=
